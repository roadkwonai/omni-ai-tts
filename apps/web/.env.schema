# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# 공개 주소라 로그인 안내 화면에 그린다. 응답 누출 감지만 끄고 민감값(빌드 인라인 없음, 로그 가림)으로 둔다
# @sensitive={preventLeaks=false} @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# 소유자 이메일 한 개(서버 전용). 비거나 둘 이상이면 모두 거부
# 소유자 본인 화면에 세션 이메일로 보이므로 응답 누출 감지만 끈다. 클라이언트 번들에는 넣지 않는다
# @optional @sensitive={preventLeaks=false} @type=string
OWNER_EMAILS=

# Typecast API key (server only; optional until TTS is connected)
# @optional @sensitive @type=string
TYPECAST_API_KEY=

# ElevenLabs API key (server only; optional until TTS is connected)
# @optional @sensitive @type=string
ELEVENLABS_API_KEY=

# Fish Audio API key (server only; optional until TTS is connected)
# @optional @sensitive @type=string
FISH_AUDIO_API_KEY=

# Airy API key (server only; optional until TTS is connected)
# @optional @sensitive @type=string
AIRY_API_KEY=

# Gemini API key (server only; optional until TTS is connected)
# @optional @sensitive @type=string
GEMINI_API_KEY=

# OpenAI API key (server only; auto tag text model, optional)
# @optional @sensitive @type=string
OPENAI_API_KEY=
