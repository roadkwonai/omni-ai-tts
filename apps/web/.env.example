# 새 환경에서 이 파일을 apps/web/.env로 복사한 후 값을 입력하세요.
# 기존 .env가 있으면 덮어쓰지 말고 필요한 항목만 추가하세요.

# 인증 비밀값: 32자 이상의 무작위 문자열로 설정하세요.
# 기존 값이 있으면 유지하세요. 새 환경에서는 openssl rand -base64 32 로 생성할 수 있습니다.
BETTER_AUTH_SECRET=
# 로컬은 아래 주소, 배포 환경은 실제 서비스의 https 주소를 입력하세요.
BETTER_AUTH_URL=http://localhost:3001

# 필수 DB 연결: 로컬 PostgreSQL 또는 Neon 연결 문자열 중 하나를 입력하세요.
# 로컬 예시: postgresql://postgres:password@localhost:5432/tts-pilot-app
# 로컬 포트는 packages/db/.env의 DB_PORT와 맞추세요.
# Neon: Console > Connect에서 사용할 브랜치/DB/역할을 선택하고 URL 전체를 복사하세요.
# 웹 앱은 pooled 연결을 사용하고 sslmode 등 URL의 연결 옵션도 유지하세요.
# 마이그레이션은 direct URL을 실행 프로세스의 DATABASE_URL로 별도 전달합니다.
# 현재 코드는 DIRECT_URL이나 NEON_API_KEY를 읽지 않습니다.
DATABASE_URL=

# 서버 전용 TTS 키. 입력 전에도 UI 개발을 진행할 수 있습니다.
# Typecast API 키: 웹 Studio 구독과 API 구독은 별도입니다.
TYPECAST_API_KEY=

# ElevenLabs API 키
ELEVENLABS_API_KEY=

# Fish Audio API 키
FISH_AUDIO_API_KEY=

# NODE_ENV는 개발 스키마/실행 도구가 설정하므로 별도 입력하지 않아도 됩니다.
