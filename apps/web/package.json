{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --port 3001 --hostname 127.0.0.1",
		"build": "tsc -b ../../packages/api && next build",
		"check-types": "next typegen && tsc -b ../../packages/api && tsc --noEmit",
		"start": "next start --hostname 127.0.0.1",
		"test": "vitest run --dir src",
		"env:generate": "varlock codegen",
		"auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
	},
	"dependencies": {
		"@orpc/client": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/tanstack-query": "^1.15.0",
		"@swc/helpers": "^0.5.23",
		"@tanstack/react-query": "^5.102.8",
		"@tts-pilot-app/api": "workspace:*",
		"@tts-pilot-app/auth": "workspace:*",
		"@tts-pilot-app/db": "workspace:*",
		"@tts-pilot-app/ui": "workspace:*",
		"@varlock/nextjs-integration": "1.2.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"better-auth": "catalog:",
		"lucide-react": "catalog:",
		"next": "^16.3.4",
		"next-themes": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"sonner": "catalog:",
		"varlock": "catalog:"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "catalog:",
		"@tts-pilot-app/config": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vitest": "^5.0.2"
	}
}
