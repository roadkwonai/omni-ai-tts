{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"agentGuidance": false,
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"],
			"outputs": ["dist/**"]
		},
		"web#check-types": {
			"dependsOn": ["^check-types"],
			"outputs": []
		},
		"@tts-pilot-app/ui#check-types": {
			"dependsOn": ["^check-types"],
			"outputs": []
		},
		"test": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:push": {
			"cache": false,
			"interactive": true
		},
		"db:generate": {
			"cache": false,
			"interactive": true
		},
		"db:migrate": {
			"cache": false,
			"interactive": true
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"db:start": {
			"cache": false
		},
		"db:stop": {
			"cache": false
		},
		"db:watch": {
			"cache": false,
			"persistent": true
		},
		"db:down": {
			"cache": false
		}
	},
	"globalEnv": [
		"AIRY_API_KEY",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"CI",
		"DATABASE_URL",
		"ELEVENLABS_API_KEY",
		"FISH_AUDIO_API_KEY",
		"GEMINI_API_KEY",
		"NODE_ENV",
		"TEST_DATABASE_URL",
		"TYPECAST_API_KEY",
		"VERCEL",
		"VERCEL_ENV",
		"VERCEL_PROJECT_PRODUCTION_URL",
		"VERCEL_URL",
		"_VARLOCK_ENV_KEY"
	],
	"globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
