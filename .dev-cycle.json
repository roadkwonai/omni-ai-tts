{
	"todoPath": "tasks/todo.md",
	"archiveDir": "tasks/archive",
	"workflowDoc": "docs/dev-workflow.md",
	"defaultBranch": "master",
	"rules": [
		{
			"case": "E",
			"match": "^packages/db/",
			"why": "DB 스키마·마이그레이션·연결"
		},
		{
			"case": "D",
			"match": "^(packages/api/|apps/web/src/app/api/)",
			"why": "서버·API"
		},
		{
			"case": "B",
			"match": "^(apps/web/src/(app|components)/|packages/ui/)",
			"why": "화면·UI"
		},
		{
			"case": "H",
			"match": "^(\\.agents/skills/|\\.claude/(agents|skills)/|\\.codex/agents/|skills-lock\\.json$|scripts/(dev-cycle|sync-agents)\\.mjs$|\\.dev-cycle\\.json$|docs/dev-workflow\\.md$)",
			"why": "하네스"
		}
	],
	"authPaths": "^(packages/auth/|apps/web/src/app/api/auth/|apps/web/src/lib/auth-client\\.ts$|apps/web/src/(proxy|middleware|services|context|env\\.server)\\.ts$|packages/api/src/(index|context)\\.ts$|packages/db/src/schema/auth\\.ts$|(.*/)?\\.env\\.schema$)",
	"ui": {
		"auditMin": 16,
		"a11yMin": 3
	},
	"commands": {
		"typecheck": "pnpm check-types",
		"lint": "pnpm exec biome check .",
		"build": "pnpm build",
		"dbGenerate": "pnpm --filter @tts-pilot-app/db db:generate",
		"dbMigrate": "pnpm --filter @tts-pilot-app/db db:migrate",
		"dbPush": "pnpm --filter @tts-pilot-app/db db:push"
	}
}
